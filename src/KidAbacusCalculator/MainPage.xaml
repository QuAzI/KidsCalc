<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KidAbacusCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KidAbacusCalculator.Controls"
    xmlns:viewModels="clr-namespace:KidAbacusCalculator.Core.ViewModels;assembly=KidAbacusCalculator.Core"
    x:DataType="viewModels:MainViewModel"
    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
    Title="Счёты">

    <ContentPage.Resources>
        <Style x:Key="RodButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#CBD5E1, Dark=#64748B}" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid
        Padding="18,16,18,20"
        ColumnDefinitions="*"
        HorizontalOptions="Center"
        MaximumWidthRequest="540"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12">

        <Border
            Padding="20,14"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
            Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#7C3AED}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="2">
            <VerticalStackLayout Spacing="0">
                <Label
                    FontSize="14"
                    Text="РЕШИ ПРИМЕР"
                    TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="44"
                    SemanticProperties.HeadingLevel="Level1"
                    Text="{Binding ProblemText}"
                    TextColor="{AppThemeBinding Light=#172554, Dark=#FFFFFF}" />
            </VerticalStackLayout>
        </Border>

        <Border
            Grid.Row="1"
            Padding="8,10"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#F8FAFC}"
            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#94A3B8}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="2">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,*,*,*">
                    <Button
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="1000"
                        SemanticProperties.Hint="Добавить тысячу"
                        Style="{StaticResource RodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="100"
                        SemanticProperties.Hint="Добавить сотню"
                        Style="{StaticResource RodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="10"
                        SemanticProperties.Hint="Добавить десяток"
                        Style="{StaticResource RodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="1"
                        SemanticProperties.Hint="Добавить единицу"
                        Style="{StaticResource RodButton}"
                        Text="+" />
                </Grid>

                <controls:AbacusView
                    Grid.Row="1"
                    SemanticProperties.Description="{Binding AbacusDescription}"
                    Value="{Binding CurrentValue}" />

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*">
                    <Button
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="1000"
                        SemanticProperties.Hint="Убрать тысячу"
                        Style="{StaticResource RodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="100"
                        SemanticProperties.Hint="Убрать сотню"
                        Style="{StaticResource RodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="10"
                        SemanticProperties.Hint="Убрать десяток"
                        Style="{StaticResource RodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="1"
                        SemanticProperties.Hint="Убрать единицу"
                        Style="{StaticResource RodButton}"
                        Text="−" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <!-- Результат объявляется screen reader из code-behind после смены состояния. -->
            <Border
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#DCFCE7, Dark=#14532D}"
                IsVisible="{Binding IsCorrectFeedback}"
                Stroke="#22C55E"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{Binding FeedbackText}"
                    TextColor="{AppThemeBinding Light=#166534, Dark=#F0FDF4}" />
            </Border>

            <Border
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#7C2D12}"
                IsVisible="{Binding IsIncorrectFeedback}"
                Stroke="#F97316"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Text="{Binding FeedbackText}"
                    TextColor="{AppThemeBinding Light=#9A3412, Dark=#FFF7ED}" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
