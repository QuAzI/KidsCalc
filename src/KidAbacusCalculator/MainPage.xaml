<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KidAbacusCalculator.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KidAbacusCalculator.Controls"
    xmlns:viewModels="clr-namespace:KidAbacusCalculator.Core.ViewModels;assembly=KidAbacusCalculator.Core"
    x:DataType="viewModels:MainViewModel"
    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
    Title="Счёты">

    <ContentPage.Resources>
        <Style x:Key="RodButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#CBD5E1, Dark=#64748B}" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="WidthRequest" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="CounterBadge" TargetType="Border">
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="WidthRequest" Value="40" />
        </Style>
        <Style x:Key="CounterText" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>

        <!-- Эти стили только приглушают ненужные разряды; IsEnabled и команды
             намеренно не меняются, чтобы все колонки оставались функциональными. -->
        <Style
            x:Key="ThousandsRodButton"
            BasedOn="{StaticResource RodButton}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsThousandsColumnRelevant}"
                    TargetType="Button"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#E2E8F0" />
                    <Setter Property="BorderColor" Value="#94A3B8" />
                    <Setter Property="TextColor" Value="#64748B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HundredsRodButton"
            BasedOn="{StaticResource RodButton}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsHundredsColumnRelevant}"
                    TargetType="Button"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#E2E8F0" />
                    <Setter Property="BorderColor" Value="#94A3B8" />
                    <Setter Property="TextColor" Value="#64748B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="TensRodButton"
            BasedOn="{StaticResource RodButton}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsTensColumnRelevant}"
                    TargetType="Button"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#E2E8F0" />
                    <Setter Property="BorderColor" Value="#94A3B8" />
                    <Setter Property="TextColor" Value="#64748B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ThousandsCounterBadge"
            BasedOn="{StaticResource CounterBadge}"
            TargetType="Border">
            <Setter Property="BackgroundColor" Value="#2563EB" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsThousandsColumnRelevant}"
                    TargetType="Border"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="HundredsCounterBadge"
            BasedOn="{StaticResource CounterBadge}"
            TargetType="Border">
            <Setter Property="BackgroundColor" Value="#7C3AED" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsHundredsColumnRelevant}"
                    TargetType="Border"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="TensCounterBadge"
            BasedOn="{StaticResource CounterBadge}"
            TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F97316" />
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding IsTensColumnRelevant}"
                    TargetType="Border"
                    Value="False">
                    <Setter Property="BackgroundColor" Value="#94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid
        Padding="9,8,9,10"
        ColumnDefinitions="*"
        HorizontalOptions="Center"
        MaximumWidthRequest="540"
        RowDefinitions="Auto,*"
        RowSpacing="12">

        <Border
            Padding="20,14"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
            Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#7C3AED}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="2">
            <Border.Triggers>
                <DataTrigger
                    Binding="{Binding IsCorrectFeedback}"
                    TargetType="Border"
                    Value="True">
                    <Setter Property="BackgroundColor" Value="#ECFDF5" />
                    <Setter Property="Stroke" Value="#22C55E" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="0">
                <Label
                    FontSize="14"
                    Text="{Binding PromptText}"
                    TextColor="{AppThemeBinding Light=#64748B, Dark=#CBD5E1}">
                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsCorrectFeedback}"
                            TargetType="Label"
                            Value="True">
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="TextColor" Value="#16A34A" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <HorizontalStackLayout
                    SemanticProperties.HeadingLevel="Level1"
                    Spacing="8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="44"
                        Text="{Binding ProblemPrefix}"
                        TextColor="{AppThemeBinding Light=#172554, Dark=#FFFFFF}"
                        VerticalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding IsCorrectFeedback}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="TextColor" Value="#16A34A" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <controls:NumericInput
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="44"
                        HorizontalTextAlignment="Center"
                        IsReadOnly="{Binding IsCorrectFeedback}"
                        MaxLength="4"
                        MinimumWidthRequest="64"
                        Placeholder="?"
                        PlaceholderColor="{AppThemeBinding Light=#172554, Dark=#FFFFFF}"
                        SemanticProperties.Description="Ответ"
                        Text="{Binding AnswerText, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light=#172554, Dark=#FFFFFF}"
                        VerticalTextAlignment="Center"
                        WidthRequest="104">
                        <controls:NumericInput.Triggers>
                            <DataTrigger
                                Binding="{Binding IsCorrectFeedback}"
                                TargetType="controls:NumericInput"
                                Value="True">
                                <Setter Property="PlaceholderColor" Value="#16A34A" />
                                <Setter Property="TextColor" Value="#16A34A" />
                            </DataTrigger>
                        </controls:NumericInput.Triggers>
                    </controls:NumericInput>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Border
            Grid.Row="1"
            Padding="8,10"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#F8FAFC}"
            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#94A3B8}"
            StrokeShape="RoundRectangle 24"
            StrokeThickness="2">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,*,*,*">
                    <Border
                        Style="{StaticResource ThousandsCounterBadge}">
                        <Label
                            Style="{StaticResource CounterText}"
                            Text="{Binding ThousandsDigit}" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Style="{StaticResource HundredsCounterBadge}">
                        <Label
                            Style="{StaticResource CounterText}"
                            Text="{Binding HundredsDigit}" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource TensCounterBadge}">
                        <Label
                            Style="{StaticResource CounterText}"
                            Text="{Binding TensDigit}" />
                    </Border>
                    <Border
                        Grid.Column="3"
                        BackgroundColor="#0F9D78"
                        Style="{StaticResource CounterBadge}">
                        <Label
                            Style="{StaticResource CounterText}"
                            Text="{Binding OnesDigit}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*">
                    <Button
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="1000"
                        SemanticProperties.Hint="Добавить тысячу"
                        Style="{StaticResource ThousandsRodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="100"
                        SemanticProperties.Hint="Добавить сотню"
                        Style="{StaticResource HundredsRodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="10"
                        SemanticProperties.Hint="Добавить десяток"
                        Style="{StaticResource TensRodButton}"
                        Text="+" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding IncrementPlaceCommand}"
                        CommandParameter="1"
                        SemanticProperties.Hint="Добавить единицу"
                        Style="{StaticResource RodButton}"
                        Text="+" />
                </Grid>

                <controls:AbacusView
                    Grid.Row="2"
                    MaximumTaskPlaceValue="{Binding MaximumTaskPlaceValue}"
                    SemanticProperties.Description="{Binding AbacusDescription}"
                    Value="{Binding CurrentValue}" />

                <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*">
                    <Button
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="1000"
                        SemanticProperties.Hint="Убрать тысячу"
                        Style="{StaticResource ThousandsRodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="100"
                        SemanticProperties.Hint="Убрать сотню"
                        Style="{StaticResource HundredsRodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="2"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="10"
                        SemanticProperties.Hint="Убрать десяток"
                        Style="{StaticResource TensRodButton}"
                        Text="−" />
                    <Button
                        Grid.Column="3"
                        Command="{Binding DecrementPlaceCommand}"
                        CommandParameter="1"
                        SemanticProperties.Hint="Убрать единицу"
                        Style="{StaticResource RodButton}"
                        Text="−" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
